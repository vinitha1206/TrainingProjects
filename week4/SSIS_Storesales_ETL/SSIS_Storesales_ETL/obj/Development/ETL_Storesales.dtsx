                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.Product.ProductID, dbo.Product.Name AS ProductName, dbo.Product.Color, dbo.Product."Size", dbo.Product.ProductCategoryID, dbo.Product.SellStartDate, dbo.Product.SellEndDate, dbo.ProductCategory.Name AS ProductCategoryName
FROM   dbo.Product, dbo.ProductCategory
WHERE dbo.Product.ProductCategoryID = dbo.ProductCategory.ProductCategoryID</property>
