  <DataSources>
    <DataSource Name="StoreSalesDataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=VINITHA_HOME\IC;Initial Catalog=IC;TrustServerCertificate=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>3600c016-e867-432c-93af-37cb8acdb34a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="StoreSalesDataset">
      <Query>
        <DataSourceName>StoreSalesDataSource</DataSourceName>
        <CommandText>SELECT StoreSales.*, Product.Name AS ProductName, ProductCategory.Name AS PrdCategoryName, Store.StoreName, Territory.Name AS TerritoryName
FROM   Product INNER JOIN
             ProductCategory ON Product.ProductCategoryID = ProductCategory.ProductCategoryID INNER JOIN
             StoreSales ON Product.ProductID = StoreSales.ProductID INNER JOIN
             Store ON StoreSales.StoreID = Store.StoreID INNER JOIN
             Territory ON Store.TerritoryID = Territory.TerritoryID</CommandText>
      </Query>
      <Fields>
        <Field Name="SalesOrderID">
          <DataField>SalesOrderID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SalesItemID">
          <DataField>SalesItemID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SalesOrderNumber">
          <DataField>SalesOrderNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SellDate">
          <DataField>SellDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ShipDate">
          <DataField>ShipDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OnlineOrderFlag">
